# Copy this file to .env in the project root and fill in your keys

# ─── SmartLUKU SMS ──────────────────────────────────────────────────
# Sandbox (hackathon / testing): username MUST be "sandbox"
SMS_USERNAME=sandbox
SMS_API_KEY=your_sandbox_api_key_here
SMS_ENV=sandbox

# Production (live Tanzania SMS):
# SMS_USERNAME=your_app_username
# SMS_API_KEY=your_production_api_key
# SMS_ENV=production
# SMS_SENDER=SmartLUKU

# Approved sender ID for production (optional in sandbox)
SMS_SENDER=

# ─── Anthropic Claude (Energy Advisor) ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Server ─────────────────────────────────────────────────────────
PORT=3001
APP_URL=http://localhost:8000

# ─── PostgreSQL ─────────────────────────────────────────────────────
# Start with: docker-compose up -d  (from project root)
# Then run: cd server && npm run migrate
DATABASE_URL=postgresql://smartluku:smartluku@localhost:5432/smartluku
